#!/usr/bin/env python3
"""new-cpp — scaffold a C or C++ CMake project pre-wired for Zed.

Creates: CMakeLists.txt, CMakePresets.json, .clangd, .clang-tidy, .clang-format,
.zed/{tasks,debug,settings}.json, .gitignore, src/main.{cpp,c}, include/.

Usage:
  new-cpp myproject                 # new C++ project in ./myproject
  new-cpp myproject --lang c        # C project instead
  new-cpp --here                    # wire up the current directory (never overwrites)
  new-cpp myproject --std 23 --open # C++23, then open in Zed
  new-cpp                           # interactive wizard (also runnable as a Zed task)

Works on macOS (Apple clang / Homebrew LLVM) and Windows (llvm-mingw + PowerShell 7).
The generated files are tailored to the OS you run this on.
"""

from __future__ import annotations

import argparse
import json
import os
import platform
import re
import shutil
import subprocess
import sys
from pathlib import Path

IS_MAC = platform.system() == "Darwin"
IS_WIN = platform.system() == "Windows"
EXE = ".exe" if IS_WIN else ""


# --------------------------------------------------------------------------- templates

def cmakelists(name: str, lang: str, std: str) -> str:
    if lang == "cpp":
        lang_kw, std_block, glob = "CXX", (
            f"set(CMAKE_CXX_STANDARD {std})\n"
            "set(CMAKE_CXX_STANDARD_REQUIRED ON)\n"
            "set(CMAKE_CXX_EXTENSIONS OFF)\n"
        ), "src/*.cpp"
        extra_warn = " -Wnon-virtual-dtor -Wold-style-cast -Woverloaded-virtual"
        tidy_prop = "CXX_CLANG_TIDY"
        compiler_var = "CMAKE_CXX_COMPILER"
    else:
        lang_kw, std_block, glob = "C", (
            f"set(CMAKE_C_STANDARD {std})\n"
            "set(CMAKE_C_STANDARD_REQUIRED ON)\n"
            "set(CMAKE_C_EXTENSIONS OFF)\n"
        ), "src/*.c"
        extra_warn = " -Wstrict-prototypes -Wmissing-prototypes"
        tidy_prop = "C_CLANG_TIDY"
        compiler_var = "CMAKE_C_COMPILER"

    return f"""cmake_minimum_required(VERSION 3.25)
project({name} VERSION 0.1.0 LANGUAGES {lang_kw})

{std_block}set(CMAKE_EXPORT_COMPILE_COMMANDS ON)   # clangd reads build/<preset>/compile_commands.json

option(ENABLE_SANITIZERS   "Build with AddressSanitizer + UBSan"  OFF)
option(ENABLE_CLANG_TIDY   "Run clang-tidy on every compile"      OFF)
option(WARNINGS_AS_ERRORS  "Treat compiler warnings as errors"    OFF)

# Every .{'cpp' if lang == 'cpp' else 'c'} under src/ is compiled. CONFIGURE_DEPENDS re-globs on each build,
# so new files are picked up automatically — no need to edit this file.
file(GLOB_RECURSE SOURCES CONFIGURE_DEPENDS "${{CMAKE_CURRENT_SOURCE_DIR}}/{glob}")

add_executable(${{PROJECT_NAME}} ${{SOURCES}})
target_include_directories(${{PROJECT_NAME}} PRIVATE "${{CMAKE_CURRENT_SOURCE_DIR}}/include")

target_compile_options(${{PROJECT_NAME}} PRIVATE
    -Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wsign-conversion{extra_warn}
    $<$<BOOL:${{WARNINGS_AS_ERRORS}}>:-Werror>
)

if(ENABLE_SANITIZERS)
    target_compile_options(${{PROJECT_NAME}} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(${{PROJECT_NAME}} PRIVATE -fsanitize=address,undefined)
endif()

if(ENABLE_CLANG_TIDY)
    find_program(CLANG_TIDY_EXE NAMES clang-tidy REQUIRED)
    set_target_properties(${{PROJECT_NAME}} PROPERTIES {tidy_prop} "${{CLANG_TIDY_EXE}}")
endif()

# Windows (llvm-mingw): programs need libc++/libunwind (and the ASan runtime) DLLs at run
# time. They live in <toolchain>/x86_64-w64-mingw32/bin, which is not on PATH, so copy
# them next to the .exe after each build. Does nothing on macOS/Linux.
if(MINGW)
    get_filename_component(_tc_bin "${{{compiler_var}}}" DIRECTORY)
    file(GLOB _rt_dlls
        "${{_tc_bin}}/../*-w64-mingw32/bin/libc++.dll"
        "${{_tc_bin}}/../*-w64-mingw32/bin/libunwind.dll"
        "${{_tc_bin}}/../*-w64-mingw32/bin/libclang_rt.asan_dynamic-*.dll")
    foreach(_dll IN LISTS _rt_dlls)
        add_custom_command(TARGET ${{PROJECT_NAME}} POST_BUILD
            COMMAND ${{CMAKE_COMMAND}} -E copy_if_different "${{_dll}}" "$<TARGET_FILE_DIR:${{PROJECT_NAME}}>")
    endforeach()
endif()

enable_testing()
add_test(NAME ${{PROJECT_NAME}}.runs COMMAND ${{PROJECT_NAME}})
"""


def presets() -> str:
    base_cache = {"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"}
    if IS_MAC:
        # CMake 4.x no longer passes -isysroot on macOS by default; without it, Homebrew
        # clangd/clang-tidy can't find the SDK headers ('iostream' file not found).
        base_cache["CMAKE_OSX_SYSROOT"] = "macosx"
    if IS_WIN:
        # Pin llvm-mingw's clang so CMake never picks up MSVC (cl) or a stray g++.
        base_cache["CMAKE_C_COMPILER"] = "clang"
        base_cache["CMAKE_CXX_COMPILER"] = "clang++"

    data = {
        "version": 6,
        "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
        "configurePresets": [
            {
                "name": "base",
                "hidden": True,
                "generator": "Ninja",
                "binaryDir": "${sourceDir}/build/${presetName}",
                "cacheVariables": base_cache,
            },
            {
                "name": "debug",
                "displayName": "Debug (+ASan/UBSan)",
                "inherits": "base",
                "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "ENABLE_SANITIZERS": "ON"},
            },
            {
                "name": "release",
                "displayName": "Release",
                "inherits": "base",
                "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"},
            },
            {
                "name": "lint",
                "displayName": "Lint (clang-tidy on every file)",
                "inherits": "base",
                "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "ENABLE_CLANG_TIDY": "ON"},
            },
        ],
        "buildPresets": [
            {"name": n, "configurePreset": n} for n in ("debug", "release", "lint")
        ],
        "testPresets": [
            {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": True}}
        ],
        "workflowPresets": [
            {
                "name": n,
                "steps": [
                    {"type": "configure", "name": n},
                    {"type": "build", "name": n},
                ],
            }
            for n in ("debug", "release", "lint")
        ]
        + [
            {
                "name": "test",
                "steps": [
                    {"type": "configure", "name": "debug"},
                    {"type": "build", "name": "debug"},
                    {"type": "test", "name": "debug"},
                ],
            }
        ],
    }
    return json.dumps(data, indent=2) + "\n"


