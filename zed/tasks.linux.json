// Global Zed tasks (Linux) — linked into ~/.config/zed/tasks.json (or $XDG_CONFIG_HOME/zed)
// by install.py. Edit this file in the repo, not the linked copy.
// "run current file" uses the system c++/cc (GCC or Clang, whichever is the default).
[
  {
    "label": "C/C++: new project (wizard)",
    "command": "~/.local/bin/new-cpp",
    "cwd": "~",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "center",
    "hide": "on_success"
  },
  {
    "label": "C++: run current file",
    "command": "mkdir -p /tmp/zed-run && c++ -std=c++23 -g -O0 -Wall -Wextra -fsanitize=address,undefined \"$ZED_FILE\" -o \"/tmp/zed-run/$ZED_STEM\" && \"/tmp/zed-run/$ZED_STEM\"",
    "cwd": "$ZED_DIRNAME",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "save": "current"
  },
  {
    "label": "C: run current file",
    "command": "mkdir -p /tmp/zed-run && cc -std=c17 -g -O0 -Wall -Wextra -fsanitize=address,undefined \"$ZED_FILE\" -o \"/tmp/zed-run/$ZED_STEM\" && \"/tmp/zed-run/$ZED_STEM\"",
    "cwd": "$ZED_DIRNAME",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "save": "current"
  }
]
